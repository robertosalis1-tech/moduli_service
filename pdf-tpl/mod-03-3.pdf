push\("report airCloud Tap non allegato"\);\n  if \(!chk\(s + "tapreg"\)\) warn.push\("carica non registrata in airCloud Tap"\);\n  if \(!chk\(s + "foto"\)\) warn.push\("foto non allegate"\);\n  // esito sistema\n  var es, col, bg, sh;\n  if \(ko.length\) { es = "NON CONFORME: " + ko.join\("; "\); col = RD; bg = BG.R; sh = "NON CONFORME"; nKo++; }\n  else if \(warn.length\) { es = "DA COMPLETARE: " + warn.join\("; "\); col = AM; bg = BG.A; sh = "Da completare"; nWarn++; }\n  else { es = "CONFORME"; col = GR; bg = BG.G; sh = "CONFORME"; nOk++; }\n  put\(s + "esito", es, col, bg\);\n  put\(r + "nome", g\(s + "nome"\)\); put\(r + "mod", mods.join\(" + "\)\); put\(r + "sn", sns.join\(" / "\)\);\n  put\(r + "ui", \(ud !== null ? ud : "-"\) + " / " + \(aa !== null ? aa : "-"\), \(aa !== null && ud !== null && aa != ud\) ? RD : BK\);\n  put\(r + "w", wc !== null ? fx\(wc, 2\) : \(any ? fx\(w, 2\) + " calc." : ""\)\);\n  put\(r + "es", sh, col, bg\);\n}\nput\("v_uitot", uiAny ? String\(uitot\) : ""\);\nvar ve = N + \(N == 1 ? " sistema: " : " sistemi: "\) + nOk + " conformi, " + nWarn + " da completare, " + nKo + " non conformi";\nput\("v_esito", ve, nKo ? RD : \(nWarn ? AM : GR\), nKo ? BG.R : \(nWarn ? BG.A : BG.G\)\);\nevent.value = "";\n) /S /JavaScript >>
