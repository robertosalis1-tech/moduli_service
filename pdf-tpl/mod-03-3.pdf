)\).toFixed\(k\).replace\(".", ","\); }\nvar GR = ["RGB", 0, 0.45, 0.15], RD = ["RGB", 0.8, 0, 0], AM = ["RGB", 0.75, 0.45, 0], BK = ["RGB", 0, 0, 0];\nvar BG = {G: ["RGB", 0.85, 0.95, 0.87], A: ["RGB", 1, 0.93, 0.78], R: ["RGB", 1, 0.86, 0.86], N: ["RGB", 0.88, 0.95, 0.89]};\nfunction put\(n, v, c, bg\){ var f = F\(n\); if \(!f\) return; if \(f.value != v\) f.value = v; f.textColor = c || BK; if \(bg\) f.fillColor = bg; }\nfunction show\(n, vis\){ var f = F\(n\); if \(f\) f.display = vis ? display.visible : display.hidden; }\n\nvar N = Number\(g\("v_nsis"\)\) || 1;\nvar nm = {};\nfor \(var i = 1; i <= 8; i++\) nm[i] = Number\(g\("s" + i + "_nmod"\)\) || 1;\n// ---------- visibilit\\u00E0 \(solo se cambia lo stato\)\nvar st = N + "|"; for \(var i = 1; i <= 8; i++\) st += nm[i];\nif \(g\("v_state"\) != st\) {\n  for \(var i = 1; i <= 8; i++\) {\n    var vis = i <= N, L = SYS[i];\n    var hideMod = {};\n    for \(var m = 2; m <= 4; m++\) { var LM = MOD[i][m]; for \(var k = 0; k < LM.length; k++\) hideMod[LM[k]] = m > nm[i]; }\n    for \(var k = 0; k < L.length; k++\) show\(L[k], vis && !hideMod[L[k]]\);\n    show\("s" + i + "_cov1", !vis\); show\("s" + i + "_cov2", !vis\);\n    for \(var m = 2; m <= 4; m++\) { show\("s" + i + "_mc" + m, vis && m > nm[i]\); show\("s" + i + "_oc" + m, vis && m > nm[i]\); }\n  }\n  var fs = F\("v_state"\); if \(fs\) fs.value = st;\n}\n// ---------- calcoli per sistema\nvar DK = [0.67, 0.52, 0.36, 0.26, 0.17, 0.11, 0.056, 0.024];\nfunction wmax\(serie, hp\){\n  if \(serie == "S"\) { if \(hp <= 10\) return 28; if \(hp <= 12\) return 36; if \(hp <= 18\) return 40; if \(hp <= 22\) return 46; if \(hp <= 24\) return 51; if \(hp <= 40\) return 56.5; if \(hp <= 66\) return 63; if \(hp <= 88\) return 73; return 93; }\n  if \(hp <= 10\) return 28; if \(hp <= 12\) return 36; if \(hp <= 18\) return 40; if \(hp <= 24\) return 51; return 63;\n}\nvar nOk = 0, nWarn = 0, nKo = 0, uitot = 0, uiAny = false;\nfor \(var i = 1; i <= 8; i++\) {\n  var s = "s"