<</JS(\nvar d = this;\nfunction g\(n\){ var f = d.getField\(n\); if \(!f || f.value === null || f.value === undefined\) return ""; return String\(f.value\); }\nfunction num\(n\){ var s = g\(n\).replace\(",", "."\).replace\(/\\s/g, ""\); if \(s === ""\) return null; var x = Number\(s\); return isNaN\(x\) ? null : x; }\nfunction put\(n, v, c\){ var f = d.getField\(n\); if \(!f\) return; if \(f.value != v\) f.value = v; f.textColor = c || color.black; }\nvar G = ["RGB", 0, 0.45, 0.15], R = ["RGB", 0.8, 0, 0], A = ["RGB", 0.75, 0.45, 0];\nvar ns = 0, td = 0, tr = 0, nd = 0, nr = 0, diff = 0, nok = 0, ok = 0;\nfor \(var i = 1; i <= 10; i++\) {\n  var pre = "cs_ue" + i + "_";\n  var used = g\(pre + "mod"\) !== "" || g\(pre + "sn"\) !== "" || g\(pre + "ui"\) !== "";\n  var di = num\(pre + "ui"\), ri = num\(pre + "uir"\);\n  var cf = d.getField\(pre + "ok"\); var conf = !!\(cf && cf.value && cf.value != "Off"\);\n  if \(used\) ns++;\n  if \(di !== null\) { td += di; nd++; }\n  if \(ri !== null\) { tr += ri; nr++; }\n  if \(conf\) ok++;\n  var es = "", col = G;\n  if \(ri !== null && di !== null\) {\n    if \(ri == di\) es = conf ? "OK" : "U.I. OK";\n    else { es = "U.I. " + \(ri > di ? "+" : ""\) + \(ri - di\); col = R; diff++; }\n  } else if \(ri !== null && di === null\) { es = "Manca dichiarato"; col = A; }\n  else if \(conf\) es = "Confermato";\n  put\(pre + "es", es, col\);\n}\nput\("cs_ue_nsis", ns ? String\(ns\) : ""\);\nput\("cs_ue_totd", nd ? String\(td\) : ""\);\nput\("cs_ue_totr", nr ? String\(tr\) : ""\);\nvar e = "", ec = G;\nif \(nr > 0\) {\n  if \(diff > 0\) { e = diff + \(diff == 1 ? " sistema" : " sistemi"\) + " con U.I. diverse dal dichiarato"; ec = R; }\n  else if \(nr < ns\) { e = "Verificati " + nr + " su " + ns + " sistemi"; ec = A; }\n  else e = "Tutti i sistemi verificati: U.I. conformi";\n}\nput\("cs_ue_esito", e, ec\);\n\nevent.value = "";\n)/S/JavaScript>>
endobj

