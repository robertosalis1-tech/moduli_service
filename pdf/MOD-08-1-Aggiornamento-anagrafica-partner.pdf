<< /JS (var d = this;\nfunction F\(n\){ return d.getField\(n\); }\nfunction g\(n\){ var f = F\(n\); if \(!f\) return ""; var v; try { v = f.valueAsString; } catch \(e\) {} if \(v === undefined || v === null\) v = f.value; if \(v === null || v === undefined\) return ""; return String\(v\); }\nfunction put\(n, v\){ var f = F\(n\); if \(!f\) return; if \(f.value != v\) f.value = v; }\nfunction ro\(n, on\){ var f = F\(n\); if \(f\) f.readonly = on; }\nvar NT = 10, NC = 16, i;\n// sede operativa = sede legale\nvar sameSO = g\("so_uguale"\) != "" && g\("so_uguale"\) != "Off";\nvar SO = [["so_indirizzo", "sl_indirizzo"], ["so_cap", "sl_cap"], ["so_citta", "sl_citta"], ["so_prov", "sl_prov"]];\nfor \(i = 0; i < SO.length; i++\) { if \(sameSO\) put\(SO[i][0], g\(SO[i][1]\)\); ro\(SO[i][0], sameSO\); }\n// nomi dei tecnici nelle tabelle successive\nfor \(i = 0; i < NT; i++\) { var nm = g\("tec" + i + "_nome"\); put\("abb" + i + "_nome", nm\); put\("dt" + i + "_nome", nm\); }\nfor \(i = 0; i < NC; i++\) { var k = parseInt\(g\("cor" + i + "_n"\), 10\); put\("cor" + i + "_nome", k > 0 ? \(g\("tec" + \(k - 1\) + "_nome"\) || "\(riga " + k + " vuota\)"\) : ""\); }\n// totali abbigliamento\nvar T = { pant: 0, maglia: 0, giacca: 0 };\nfor \(i = 0; i < NT; i++\) for \(var c in T\) { var q = Number\(g\("abb" + i + "_" + c + "_q"\).replace\(",", "."\)\); if \(!isNaN\(q\)\) T[c] += q; }\nput\("tot_pant", T.pant ? String\(T.pant\) : ""\); put\("tot_maglia", T.maglia ? String\(T.maglia\) : ""\); put\("tot_giacca", T.giacca ? String\(T.giacca\) : ""\);\n// legale rappresentante nel riquadro firma\nif \(g\("lr_nome"\) == "" && g\("legale_rapp"\) != ""\) put\("lr_nome", g\("legale_rapp"\)\);\n) /S /JavaScript >>
endobj
