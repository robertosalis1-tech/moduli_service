impianto"\), hyd = null;\nif \(/^\(Heating|Yutampo|Samurai\)/.test\(fam\) || /idronico/i.test\(tip\)\) hyd = true;\nelse if \(/^\(Residenziale|Commerciale|VRF\)/.test\(fam\) || /^\(RAC|VRF\)/.test\(tip\)\) hyd = false;\nput\("lbl_t1", hyd === true ? "T mandata acqua \(\\u00B0C\)" : hyd === false ? "T aria ripresa U.I. \(\\u00B0C\)" : "Temp. mandata \(\\u00B0C\)"\);\nput\("lbl_t2", hyd === true ? "T ritorno acqua \(\\u00B0C\)" : hyd === false ? "T aria mandata U.I. \(\\u00B0C\)" : "Temp. ritorno \(\\u00B0C\)"\);\nevent.value = "";\n) /S /JavaScript >>
