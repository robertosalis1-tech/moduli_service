<< /JS (var d = this;\nfunction F\(n\){ return d.getField\(n\); }\nfunction g\(n\){ var f = F\(n\); if \(!f\) return ""; var v; try { v = f.valueAsString; } catch \(e\) {} if \(v === undefined || v === null\) v = f.value; if \(v === null || v === undefined\) return ""; return String\(v\); }\nvar GR = ["RGB", 0, 0.45, 0.15], RD = ["RGB", 0.8, 0, 0], AM = ["RGB", 0.75, 0.45, 0], BK = ["RGB", 0, 0, 0];\nvar BG = {G: ["RGB", 0.85, 0.95, 0.87], A: ["RGB", 1, 0.93, 0.78], R: ["RGB", 1, 0.86, 0.86], N: ["RGB", 0.88, 0.95, 0.89]};\nfunction UP\(n, f, v\){ try { if \(f.type == "text" && !/^v_/.test\(n\) && typeof v == "string"\) return v.toUpperCase\(\); } catch \(e\) {} return v; }\nfunction put\(n, v, c, bg\){ var f = F\(n\); if \(!f\) return; v = UP\(n, f, v\); if \(f.value != v\) f.value = v; f.textColor = c || BK; if \(bg\) f.fillColor = bg; }\nfunction pd\(s\){ s = String\(s || ""\).replace\(/\\s/g, ""\); var m = /^\(\\d{1,2}\)[\\/.\\-]\(\\d{1,2}\)[\\/.\\-]\(\\d{2,4}\)$/.exec\(s\);\n  if \(m\) { var y = Number\(m[3]\); if \(y < 100\) y += 2000; var dt = new Date\(y, Number\(m[2]\) - 1, Number\(m[1]\)\); return isNaN\(dt.getTime\(\)\) ? null : dt; }\n  m = /^\(\\d{4}\)-\(\\d{1,2}\)-\(\\d{1,2}\)$/.exec\(s\); if \(m\) return new Date\(Number\(m[1]\), Number\(m[2]\) - 1, Number\(m[3]\)\); return null; }\nfunction addM\(dt, n\){ var r = new Date\(dt.getFullYear\(\), dt.getMonth\(\) + n, dt.getDate\(\)\); if \(r.getDate\(\) != dt.getDate\(\)\) r = new Date\(r.getFullYear\(\), r.getMonth\(\), 0\); return r; }\nfunction fmt\(dt\){ function z\(x\){ return \(x < 10 ? "0" : ""\) + x; } return z\(dt.getDate\(\)\) + "/" + z\(dt.getMonth\(\) + 1\) + "/" + dt.getFullYear\(\); }\nfunction days\(a, b\){ return Math.round\(\(b.getTime\(\) - a.getTime\(\)\) / 864e5\); }\n// regole delle Condizioni Generali di Garanzia BHC Italia \(rev. 01/2026\)\n// ext = mesi di estensione dal termine della base; cop = cosa copre; lab = manodopera; sat = estensione solo con avviamento SAT\nvar R = {\n  "Residenziale": { ext: 48, cop: "solo schede elettroniche e compressore \(ricambi e trasporto\), manodopera esclusa", comp: ["Scheda elettronica", "Compressore"], lab: false, sat: false },\n  "Commerciale Utopia": { ext: 36, cop: "solo ricambi \(componenti dell'unit\\u00E0\), manodopera esclusa; senza primo avviamento da SAT nessuna estensione", comp: null, lab: false, sat: true },\n  "VRF Set Free": { ext: 24, cop: "tutti i componenti, ricambi e manodopera compresi", comp: null, lab: true, sat: true },\n  "Heating Solution": { ext: 36, cop: "tutti i componenti, manodopera esclusa \(inclusa con contratto di manutenzione attivato entro 3 mesi dall'avviamento\)", comp: null, lab: false, sat: true, contr: true },\n  "Yutampo": { ext: 48, cop: "solo schede elettroniche e compressore, esclusi manodopera e serbatoio ACS \(serbatoio coperto con ATW-CP-05 e avviamento SAT\)", comp: ["Scheda elettronica", "Compressore"], lab: false, sat: false, tank: true },\n  "Commerciale Primairy": { ext: 0, cop: "estensione non prevista", comp: null, lab: false, sat: false },\n  "Samurai": { ext: 0, cop: "estensione non prevista \(avviamento SAT condizione necessaria per la garanzia\)", comp: null, lab: false, sat: false, need: true }\n};\n// ---------- registro BHC incluso nel modulo \(chiave = hash della matricola\)\nfunction h32\(t, h\){ for \(var i = 0; i < t.length; i++\) { h ^= t.charCodeAt\(i\); h = \(h + \(h << 1\) + \(h << 4\) + \(h << 7\) + \(h << 8\) + \(h << 24\)\) >>> 0; } return h; }\nfunction dd0\(c\){ if \(!c\) return null; return new Date\(2000, 0, 1 + parseInt\(c, 36\)\); }\nvar snN = g\("ser_ue"\).toUpperCase\(\).replace\(/[^A-Z0-9]/g, ""\), RG = null;\nvar hasReg = \(typeof REGS != "undefined"\) && REGS.length > 2;\nfunction modCore\(mod\){ var m = String\(mod || ""\).toUpperCase\(\).replace\(/[^A-Z0-9.,]/g, ""\).replace\(/,/g, "."\); var x = /^\([A-Z]+\)\(\\d+\(?:\\.\\d+\)?\)\([A-Z]+\)/.exec\(m\); if \(!x\) return m.replace\(/[^A-Z0-9]/g, ""\); return x[1] + String\(parseFloat\(x[2]\)\) + x[3]; }\nvar snK = snN.replace\(/^0+/, ""\), snCorta = snK.length > 0 && snK.length <= 6;\nif \(snCorta\) snK = modCore\(g\("mod_ue"\)\) ? snK + "@" + modCore\(g\("mod_ue"\)\) : "";\nif \(hasReg && snN.length >= 3 && snK\) {\n  var rk = h32\(snK, 2166136261\).toString\(36\) + h32\(snK, 1592653589\).toString\(36\), ri = REGS.indexOf\(";" + rk + "="\);\n  if \(ri >= 0\) { var rv = REGS.substring\(ri + rk.length + 2, REGS.indexOf\(";", ri + 1\)\).split\(","\); RG = { mod: REGM[parseInt\(rv[0], 36\)] || "", usc: dd0\(rv[1]\), avv: dd0\(rv[2]\), acq: dd0\(rv[3]\), ci: dd0\(rv[4]\), cf: dd0\(rv[5]\), sat: rv[6] == "1" }; }\n}\nfunction fmt0\(dt\){ function z\(x\){ return \(x < 10 ? "0" : ""\) + x; } return z\(dt.getDate\(\)\) + "/" + z\(dt.getMonth\(\) + 1\) + "/" + dt.getFullYear\(\); }\nfunction fillIf\(n, v\){ var f = F\(n\); if \(f && v && !g\(n\)\) f.value = v; }\nif \(g\("v_reg"\) != snK\) {\n  if \(RG\) {\n    fillIf\("mod_ue", RG.mod\);\n    if \(RG.acq\) { fillIf\("gar_acq", fmt0\(RG.acq\)\); }\n    if \(RG.avv\) { fillIf\("gar_avv", fmt0\(RG.avv\)\); fillIf\("data_avv", fmt0\(RG.avv\)\); }\n    if \(RG.sat\) fillIf\("gar_avv_sat", "SI"\);\n    if \(RG.usc\) { fillIf\("gar_uscita", fmt0\(RG.usc\)\); fillIf\("gar_uscita_fonte", "Archivio spedizioni BHC"\); }\n    if \(RG.ci\) { fillIf\("gar_contratto", "SI"\); fillIf\("gar_contratto_data", fmt0\(RG.ci\)\); }\n  }\n  F\("v_reg"\).value = snK;\n}\nvar regTxt = "";\nif \(!hasReg\) regTxt = "Registro non incluso in questa copia del modulo: verifica a cura di BHC.";\nelse if \(snN.length < 3\) regTxt = "Scrivere la matricola dell'unit\\u00E0 esterna a pag. 1 \(registro aggiornato al " + REG_INFO.data + ", " + REG_INFO.n + " matricole\).";\nelse if \(snCorta && !snK\) regTxt = "Matricola corta \(" + g\("ser_ue"\) + "\): per la ricerca nel registro indicare anche il Modello U.E., perch\\u00E9 lo stesso numero esiste su modelli diversi.";\nelse if \(!RG\) regTxt = "Matricola " + g\("ser_ue"\) + " NON trovata nel registro" + \(snCorta ? " per il modello " + g\("mod_ue"\) : ""\) + " \(aggiornato al " + REG_INFO.data + "\): controllare la matricola o chiedere verifica a BHC.";\nelse regTxt = "Trovata: " + RG.mod + \(RG.usc ? " - spedita " + fmt0\(RG.usc\) : ""\) + \(RG.avv ? " - avviata " + fmt0\(RG.avv\) + \(RG.sat ? " da SAT" : ""\) : " - avviamento non registrato"\) + \(RG.acq ? " - acquisto " + fmt0\(RG.acq\) : ""\) + \(RG.ci ? " - contratto manutenzione dal " + fmt0\(RG.ci\) + \(RG.cf ? " al " + fmt0\(RG.cf\) : ""\) : ""\) + " \(registro al " + REG_INFO.data + "\)";\nput\("gar_reg", regTxt, RG ? GR : \(hasReg && snN.length >= 3 ? AM : BK\)\);\nvar mod = g\("mod_ue"\).replace\(/\\s/g, ""\).toUpperCase\(\);\nput\("gar_mod_ue", g\("mod_ue"\)\); put\("gar_ser_ue", g\("ser_ue"\)\);\n// proposta della serie dal modello dell'unit\\u00E0 esterna\nfunction guessS\(m, soloUE\){ m = String\(m || ""\).replace\(/\\s/g, ""\).toUpperCase\(\);\n  if \(/^RAW-|^RAM-Y/.test\(m\)\) return "Yutampo / Triple C \(2+4\)";\n  if \(!soloUE && /^RW[DMHC]-|^DHW[ST]-|^TAW-|^YUTAKI/.test\(m\)\) return "Heating Solution airH2O / Yutaki \(2+3\)";\n  if \(/^RAC-|^RAM-/.test\(m\)\) return "Residenziale mono e multi \(2+4\)";\n  if \(/^RASM-|^RAS-.*WH/.test\(m\)\) return "Heating Solution airH2O / Yutaki \(2+3\)";\n  if \(/^RAS-?[\\d.]*F[SX]/.test\(m\)\) return "VRF Set Free \(2+2\)";\n  if \(/UFES/.test\(m\)\) return "Commerciale Primairy \(2\)";\n  if \(/^RHMA-|^RCME-/.test\(m\)\) return "Samurai \(2\)";\n  if \(/^RASC-|^RAS-.*\(HNC2E|HRC2E|HVNC2E|HVRC2E|HVRC3|HNP2E|HRP2E|HVNP2E|HVRP2E|XHN|XHVN\)/.test\(m\)\) return "Commerciale Utopia & IVX \(2+3\)";\n  return ""; }\nvar guess = guessS\(mod\);\nvar fam = g\("gar_famiglia"\);\n// menu dei modelli U.E. \(pag. 1\) filtrato per serie: elenco dai modelli del registro, campo sempre scrivibile\nvar TIPMAP = { "RAC \(split / multisplit\)": "Residenziale", "VRF": "VRF Set Free", "HS \\u2013 Yutaki \(idronico\)": "Heating Solution" };\nvar serSel = fam || "";\nif \(!serSel\) { var tpi = g\("tipo_impianto"\); for \(var k0 in TIPMAP\) if \(tpi == k0\) serSel = TIPMAP[k0]; }\nif \(typeof REGM != "undefined" && g\("v_modlist"\) != serSel + "|" + REGM.length\) {\n  var ML = [], seen = {};\n  var LM = \(typeof REGML != "undefined"\) ? REGML : REGM;\n  for \(var i0 = 0; i0 < LM.length; i0++\) { var m0 = LM[i0], s0 = guessS\(m0, true\); if \(m0 && s0 && !seen[m0] && \(!serSel || s0.indexOf\(serSel.split\(" \("\)[0]\) == 0\)\) { seen[m0] = 1; ML.push\(m0\); } }\n  ML.sort\(\);\n  var fm = F\("mod_ue"\), keepV = g\("mod_ue"\);\n  try { if \(fm && fm.type == "combobox"\) { fm.setItems\([""].concat\(ML\)\); if \(keepV\) fm.value = keepV; } } catch \(e0\) {}\n  var fvm = F\("v_modlist"\); if \(fvm\) fvm.value = serSel + "|" + REGM.length;\n}\nif \(!fam && guess\) { F\("gar_famiglia"\).value = guess; fam = guess; }\nvar key = null; for \(var k in R\) if \(fam.indexOf\(k\) == 0\) key = k;\nvar r = key ? R[key] : null, is800 = /TW2E/.test\(mod\);\nvar GYc = ["RGB", 0.85, 0.86, 0.88], YLc = ["RGB", 1, 0.97, 0.77];\nfunction en\(n, on\){ var f = F\(n\); if \(!f\) return; if \(!on && g\(n\)\) f.value = ""; if \(f.readonly != !on\) f.readonly = !on; f.fillColor = on ? YLc : GYc; }\nfunction vis\(n, on\){ var f = F\(n\), cv = F\("cov_" + n\); if \(!on && g\(n\)\) f.value = ""; var w = on ? display.visible : display.hidden; if \(f && f.display != w\) f.display = w; if \(cv\) { var w2 = on ? display.hidden : display.visible; if \(cv.display != w2\) cv.display = w2; } }\nvis\("gar_visita", !key || \(key == "Heating Solution" && \(is800 || !mod\)\)\);\nvis\("gar_cp05", !key || key == "Yutampo"\);\nvar acq = pd\(g\("gar_acq"\)\), avv = pd\(g\("gar_avv"\)\) || pd\(g\("data_avv"\)\), usc = pd\(g\("gar_uscita"\)\);\nvar oggi = new Date\(\), rif = pd\(g\("gar_rif"\)\) || pd\(g\("data_intervento"\)\) || new Date\(oggi.getFullYear\(\), oggi.getMonth\(\), oggi.getDate\(\)\);\nvar det = [], es = "", c = BK, bg = BG.N, base = null, ext = null, dec = null, stima = false, extOk = false;\nif \(fam && guess && fam != guess\) det.push\("Il modello " + g\("mod_ue"\) + " sembra della serie " + guess + ": verificare la serie scelta"\);\nif \(!r\) es = "Scegliere la serie di prodotto";\nelse {\n  // decorrenza: fa fede il primo avviamento se entro 12 mesi dall'acquisto, altrimenti la data di acquisto; la data di spedizione si usa solo se mancano entrambe\n  if \(acq && avv\) { if \(avv <= addM\(acq, 12\)\) dec = avv; else { dec = acq; det.push\("Avviamento oltre 12 mesi dall'acquisto: la garanzia decorre dalla data di acquisto"\); } }\n  else if \(avv\) dec = avv;\n  else if \(acq\) dec = acq;\n  else if \(!usc && /^\\d{3,}\([A-L]\)\(\\d\)/.test\(snN\)\) {\n    var mp = /^\\d{3,}\([A-L]\)\(\\d\)/.exec\(snN\), my = 2020 + Number\(mp[2]\); if \(my > oggi.getFullYear\(\)\) my -= 10;\n    var prod = new Date\(my, mp[1].charCodeAt\(0\) - 65, 15\); dec = addM\(prod, 6\); stima = true;\n    det.push\("Stima dalla matricola: unit\\u00E0 prodotta " + \(mp[1].charCodeAt\(0\) - 64\) + "/" + my + " \(lettera = mese, cifra = anno\); decorrenza stimata a 6 mesi dalla produzione, da confermare con il documento fiscale"\);\n  }\n  else if \(usc\) { dec = addM\(usc, 6\); stima = true; det.push\("Mancano acquisto e avviamento: decorrenza stimata a 6 mesi dall'uscita magazzino, richiedere il documento fiscale"\); }\n  if \(acq && avv && avv < acq\) det.push\("Avviamento precedente all'acquisto: verificare le date"\);\n  if \(!acq && avv\) det.push\("Decorrenza dalla data di avviamento: tenere copia del documento fiscale"\);\n  if \(!dec\) es = "Indicare la data di acquisto \(documento fiscale\) o di avviamento";\n  else {\n    base = addM\(dec, 24\);\n    var asat = g\("gar_avv_sat"\);\n    if \(r.need && asat == "NO"\) { es = "NON IN GARANZIA: Samurai richiede l'avviamento eseguito da un SAT autorizzato"; c = RD; bg = BG.R; }\n    // condizioni per l'estensione\n    extOk = r.ext > 0;\n    if \(extOk && r.sat && asat == "NO"\) { extOk = false; det.push\("Estensione non riconosciuta: avviamento non eseguito da SAT autorizzato"\); }\n    else if \(extOk && r.sat && !avv && asat != "SI"\) { extOk = false; det.push\("Estensione non riconosciuta: primo avviamento da SAT non registrato \(se eseguito, indicare data e SAT\)"\); }\n    if \(extOk && r.sat && asat != "SI"\) det.push\("Estensione subordinata all'avviamento da SAT autorizzato: da confermare"\);\n    if \(asat == "Non noto"\) det.push\("Avviamento da SAT non noto: chiedere a BHC \(service-italia@bosch-hcgroup.com\)"\);\n    if \(extOk && key == "Heating Solution" && is800 && g\("gar_visita"\) == "NO"\) { extOk = false; det.push\("airH2O 800 senza visita pre-installativa: estensione non riconosciuta"\); }\n    if \(extOk && key == "Heating Solution" && is800 && g\("gar_visita"\) != "SI" && g\("gar_visita"\) != "NO"\) det.push\("airH2O 800: indicare se \\u00E8 stata eseguita la visita pre-installativa"\);\n    if \(extOk\) ext = addM\(base, r.ext\);\n    var lab = r.lab;\n    if \(r.contr && g\("gar_contratto"\) == "SI"\) {\n      var cd = pd\(g\("gar_contratto_data"\)\);\n      if \(RG && RG.ci && cd && cd.getTime\(\) == RG.ci.getTime\(\)\) { lab = true; det.push\("Contratto di manutenzione registrato da BHC"\); }\n      else if \(cd && avv && cd <= addM\(avv, 3\)\) lab = true;\n      else if \(cd && avv\) det.push\("Contratto attivato oltre 3 mesi dall'avviamento: manodopera non inclusa nell'estensione"\);\n      else { lab = true; det.push\("Indicare data di attivazione del contratto \(entro 3 mesi dall'avviamento\) per confermare la manodopera"\); }\n    }\n    if \(lab && r.contr && RG && RG.cf && rif > RG.cf\) { lab = false; det.push\("Contratto di manutenzione non rinnovato \(ultima copertura fino al " + fmt0\(RG.cf\) + "\): manodopera non inclusa"\); }\n    var comp = g\("gar_comp"\), compOk = true;\n    if \(r.comp && comp && comp != "Non ancora definito" && r.comp.indexOf\(comp\) < 0\) {\n      compOk = false;\n      if \(r.tank &