 + " V: " + \(okv ? "nei limiti \(230 V \\u00B110%\)" : "fuori dai limiti 207-253 V"\)\); W\(okv ? GR : RD\); } }\nelse {\n  if \(VV.length == 3\) { var sv = sq\(VV\), mv = avg\(VV\), cv = sv <= 2 ? GR : sv <= 3 ? AM : RD; put\("sq_v", fx\(sv, 1\), cv\);\n    es.push\("Tensioni: media " + fx\(mv, 0\) + " V, squilibrio " + fx\(sv, 1\) + "% " + \(sv <= 2 ? "OK" : sv <= 3 ? "al limite \(max 3%\)" : "FUORI LIMITE \(max 3%\): verificare rete e serraggi"\)\); W\(cv\);\n    if \(mv < 360 || mv > 440\) { es.push\("tensione media fuori da 400 V \\u00B110%"\); W\(RD\); } }\n  else { put\("sq_v", ""\); if \(VV.length\) es.push\("Tensioni: inserire le tre misure"\); }\n  if \(II.length == 3\) { var si = sq\(II\), ci = si <= 10 ? GR : RD; put\("sq_i", fx\(si, 1\), ci\);\n    es.push\("Correnti: squilibrio " + fx\(si, 1\) + "% " + \(si <= 10 ? "OK" : "ELEVATO \(oltre 10%\): verificare compressore, contattori e avvolgimenti"\)\); W\(ci\); }\n  else { put\("sq_i", ""\); if \(II.length\) es.push\("Correnti: inserire le tre misure"\); } }\nput\("sq_es", es.join\(" - "\), [GR, AM, RD][wc]\); fit\("sq_es"\);\n// ---------- resistenza H-LINK\nvar rh = nn\("r_hlink"\);\nif \(rh === null\) put\("r_hlink_es", ""\);\nelse if \(rh >= 60 && rh <= 90\) put\("r_hlink_es", "OK \(2 resistenze terminali\)", GR\);\nelse if \(rh >= 120 && rh <= 180\) put\("r_hlink_es", "1 sola resistenza terminale attiva", AM\);\nelse if \(rh < 60\) put\("r_hlink_es", "Troppe terminali attive o corto", RD\);\nelse if \(rh > 180\) put\("r_hlink_es", "Linea aperta / terminali escluse", RD\);\nelse put\("r_hlink_es", "Da verificare \(atteso 75 Ohm\)", AM\);\n// ---------- compressore: avvolgimenti e isolamento\nvar RR = vals\(["r_uv", "r_vw", "r_wu"]\);\nif \(RR.length < 3\) put\("r_av_es", RR.length ? "3 misure" : ""\);\nelse { var mx = Math.max\(RR[0], RR[1], RR[2]\), mn = Math.min\(RR[0], RR[1], RR[2]\), sr = sq\(RR\);\n  if \(mx > 100\) put\("r_av_es", "Avvolg. interrotto", RD\); else if \(mn <= 0\) put\("r_av_es",