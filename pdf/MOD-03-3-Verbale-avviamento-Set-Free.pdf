)\).toFixed\(k\).replace\(".", ","\); }\nvar GR = ["RGB", 0, 0.45, 0.15], RD = ["RGB", 0.8, 0, 0], AM = ["RGB", 0.75, 0.45, 0], BK = ["RGB", 0, 0, 0];\nvar BG = {G: ["RGB", 0.85, 0.95, 0.87], A: ["RGB", 1, 0.93, 0.78], R: ["RGB", 1, 0.86, 0.86], N: ["RGB", 0.88, 0.95, 0.89]};\nfunction put\(n, v, c, bg\){ var f = F\(n\); if \(!f\) return; if \(f.value != v\) f.value = v; f.textColor = c || BK; if \(bg\) f.fillColor = bg; }\nfunction show\(n, vis\){ var f = F\(n\); if \(f\) f.display = vis ? display.visible : display.hidden; }\n\nvar N = Number\(g\("v_nsis"\)\) || 1;\nvar nm = {};\nfor \(var i = 1; i <= 8; i++\) nm[i] = Number\(g\("s" + i + "_nmod"\)\) || 1;\n// ---------- visibilit\\u00E0 \(solo se cambia lo stato\)\nvar st = N + "|"; for \(var i = 1; i <= 8; i++\) st += nm[i];\nif \(g\("v_state"\) != st\) {\n  for \(var i = 1; i <= 8; i++\) {\n    var vis = i <= N, L = SYS[i];\n    var hideMod = {};\n    for \(var m = 2; m <= 4; m++\) { var LM = MOD[i][m]; for \(var k = 0; k < LM.length; k++\) hideMod[LM[k]] = m > nm[i]; }\n    for \(var k = 0; k < L.length; k++\) show\(L[k], vis && !hideMod[L[k]]\);\n    show\("s" + i + "_cov1", !vis\); show\("s" + i + "_cov2", !vis\);\n    for \(var m = 2; m <= 4; m++\) { show\("s" + i + "_mc" + m, vis && m > nm[i]\); show\("s" + i + "_oc" + m, vis && m > nm[i]\); }\n  }\n  var fs = F\("v_state"\); if \(fs\) fs.value = st;\n}\n// ---------- calcoli per sistema\nvar DK = [0.67, 0.52, 0.36, 0.26, 0.17, 0.11, 0.056, 0.024];\nfunction wmax\(serie, hp\){\n  if \(serie == "S"\) { if \(hp <= 10\) return 28; if \(hp <= 12\) return 36; if \(hp <= 18\) return 40; if \(hp <= 22\) return 46; if \(hp <= 24\) return 51; if \(hp <= 40\) return 56.5; if \(hp <= 66\) return 63; if \(hp <= 88\) return 73; return 93; }\n  if \(hp <= 10\) return 28; if \(hp <= 12\) return 36; if \(hp <= 18\) return 40; if \(hp <= 24\) return 51; return 63;\n}\nvar nOk = 0, nWarn = 0, nKo = 0, uitot = 0, uiAny = false;\nfor \(var i = 1; i <= 8; i++\) {\n  var s = "s" + i + "_", r = "r" + i + "_";\n  if \(i > N\) { put\(r + "nome", ""\); put\(r + "mod", ""\); put\(r + "sn", ""\); put\(r + "ui", ""\); put\(r + "w", ""\); put\(r + "es", "", BK, BG.N\); continue; }\n  var ko = [], warn = [];\n  // moduli\n  var mods = [], sns = [], hp = 0, ser = {}, n24 = 0, unk = false;\n  for \(var m = 1; m <= nm[i]; m++\) {\n    var md = g\(s + "m" + m + "_mod"\), sn = g\(s + "m" + m + "_sn"\);\n    if \(md\) mods.push\(md\); if \(sn\) sns.push\(sn\);\n    var mm = /RAS-?\(\\d+\)FSXN\(S|P\)2E/i.exec\(md\);\n    if \(mm\) { hp += Number\(mm[1]\); ser[mm[2].toUpperCase\(\)] = 1; if \(/24FSXNS2E/i.test\(md\)\) n24++; } else if \(md\) unk = true;\n  }\n  if \(mods.length < nm[i] || sns.length < nm[i]\) warn.push\("modelli/matricole incompleti"\);\n  if \(ser.S && ser.P\) ko.push\("combinazione Max + Max Pro non ammessa"\);\n  var serie = ser.P ? "P" : "S";\n  // U.I.\n  var aa = num\(s + "aa"\), ud = num\(s + "ui_dich"\);\n  if \(aa !== null\) { uitot += aa; uiAny = true; }\n  if \(aa !== null && ud !== null\) {\n    if \(aa == ud\) put\(s + "aa_es", "Conforme: " + aa + " U.I.", GR\);\n    else { put\(s + "aa_es", "Diverso: dichiarate " + ud + ", AA " + aa, RD\); ko.push\("U.I. AA diverse dal dichiarato"\); }\n  } else put\(s + "aa_es", aa === null ? "" : "Indicare le U.I. dichiarate", AM\);\n  // delta T aria\n  var ti = num\(s + "ti"\), to = num\(s + "toi"\);\n  put\(s + "dt", \(ti !== null && to !== null\) ? fx\(Math.abs\(ti - to\), 1\) : ""\);\n  // vuoto\n  var vu = num\(s + "vuoto"\);\n  if \(vu === null\) { put\(s + "vuoto_es", ""\); warn.push\("grado di vuoto mancante"\); }\n  else if \(vu <= 500\) put\(s + "vuoto_es", "OK", GR\); else { put\(s + "vuoto_es", "Oltre 500 mTorr", RD\); ko.push\("vuoto oltre 500 mTorr"\); }\n  // tensioni\n  var v1 = num\(s + "v12"\), v2 = num\(s + "v23"\), v3 = num\(s + "v31"\);\n  if \(v1 !== null && v2 !== null && v3 !== null\) {\n    var av = \(v1 + v2 + v3\) / 3, dv = Math.max\(Math.abs\(v1 - av\), Math.abs\(v2 - av\), Math.abs\(v3 - av\)\) / av * 100;\n    if \(dv <= 2\) put\(s + "vsq", fx\(dv, 1\) + " % OK", GR\); else { put\(s + "vsq", fx\(dv, 1\) + " % oltre 2%", RD\); warn.push\("squilibrio tensione oltre 2%"\); }\n  } else put\(s + "vsq", ""\);\n  // carica\n  var w1 = 0, any = false;\n  for \(var k = 1; k <= 8; k++\) { var L1 = num\(s + "l" + k\); if \(L1 !== null\) { any = true; var wk = L1 * DK[k - 1]; w1 += wk; put\(s + "w1_" + k, fx\(wk, 2\)\); } else put\(s + "w1_" + k, ""\); }\n  var w2 = num\(s + "w2"\) || 0, w6 = num\(s + "w6"\) || 0, w5 = 0.8 * n24;\n  put\(s + "w1", any ? fx\(w1, 2\) : ""\); put\(s + "w5", n24 ? fx\(w5, 1\) : \(hp ? "0" : ""\)\);\n  var w = w1 + w2 + w5 + w6, wm = hp ? wmax\(serie, hp\) : null;\n  put\(s + "w", any ? fx\(w, 2\) : ""\); put\(s + "wmax", wm !== null ? fx\(wm, 1\) + " \(" + hp + " HP\)" : \(unk ? "serie precedente: vedi manuale" : ""\)\);\n  var wc = num\(s + "wcar"\);\n  if \(wm !== null && any && w > wm\) ko.push\("W oltre la carica massima"\);\n  if \(wc === null\) { put\(s + "w_es", any ? "Indicare la carica caricata" : "", AM\); if \(any\) warn.push\("carica caricata mancante"\); }\n  else if \(!any\) put\(s + "w_es", "Inserire le lunghezze", AM\);\n  else if \(wm !== null && wc > wm\) { put\(s + "w_es", "Oltre la carica massima", RD\); ko.push\("carica oltre il massimo"\); }\n  else if \(Math.abs\(wc - w\) <= 0.5\) put\(s + "w_es", "OK \(scarto " + fx\(wc - w, 2\) + " kg\)", GR\);\n  else { put\(s + "w_es", "Scarto " + fx\(wc - w, 2\) + " kg \(> 0,5\)", AM\); warn.push\("carica diversa dal calcolo"\); }\n  // giunti\n  var gNo = 0, gMiss = 0;\n  for \(var k = 1; k <= 8; k++\) { var y = chk\(s + "gk" + k + "_SI"\), n = chk\(s + "gk" + k + "_NO"\), a = chk\(s + "gk" + k + "_NA"\); if \(n\) gNo++; else if \(!y && !a\) gMiss++; }\n  if \(gNo\) ko.push\(gNo + " verifiche giunti/collettori NO"\); else if \(gMiss\) warn.push\(gMiss + " verifiche giunti non compilate"\);\n  // airCloud Tap\n  if \(!chk\(s + "tap"\)\) ko.push\("report airCloud Tap mancante"\);\n  if \(!chk\(s + "tapreg"\)\) warn.push\("carica non registrata in airCloud Tap"\);\n  if \(!chk\(s + "foto"\)\) warn.push\("foto non allegate"\);\n  // esito sistema\n  var es, col, bg, sh;\n  if \(ko.length\) { es = "NON CONFORME: " + ko.join\("; "\); col = RD; bg = BG.R; sh = "NON CONFORME"; nKo++; }\n  else if \(warn.length\) { es = "DA COMPLETARE: " + warn.join\("; "\); col = AM; bg = BG.A; sh = "Da completare"; nWarn++; }\n  else { es = "CONFORME"; col = GR; bg = BG.G; sh = "CONFORME"; nOk++; }\n  put\(s + "esito", es, col, bg\);\n  put\(r + "nome", g\(s + "nome"\)\); put\(r + "mod", mods.join\(" + "\)\); put\(r + "sn", sns.join\(" / "\)\);\n  put\(r + "ui", \(ud !== null ? ud : "-"\) + " / " + \(aa !== null ? aa : "-"\), \(aa !== null && ud !== null && aa != ud\) ? RD : BK\);\n  put\(r + "w", wc !== null ? fx\(wc, 2\) : \(any ? fx\(w, 2\) + " calc." : ""\)\);\n  put\(r + "es", sh, col, bg\);\n}\nput\("v_uitot", uiAny ? String\(uitot\) : ""\);\nvar ve = N + \(N == 1 ? " sistema: " : " sistemi: "\) + nOk + " conformi, " + nWarn + " da completare, " + nKo + " non conformi";\nput\("v_esito", ve, nKo ? RD : \(nWarn ? AM : GR\), nKo ? BG.R : \(nWarn ? BG.A : BG.G\)\);\nevent.value = "";\n) /S /JavaScript >>
