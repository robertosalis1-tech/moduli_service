cegliere il modello"\)\);\nvar q = num\("portata"\); if \(isYtc\) q = null;\nput\("portata_lim", ix >= 0 ? fx\(H.mn[ix], 1\) + " - " + fx\(H.mx[ix], 1\) + " m3/h" : ""\);\nif \(q === null && typeof qc != "undefined" && qc !== null\) q = qc;\nif \(isYtc\) put\("portata_es", "", BK, BG.N\); else if \(ix < 0 || q === null\) { put\("portata_es", q === null ? \(ix >= 0 ? "Indicare la portata misurata" : ""\) : "Scegliere tipo e potenza per il confronto", AM, BG.N\); if \(q === null\) miss.push\("portata acqua"\); }\nelse if \(q < H.mn[ix]\) { put\("portata_es", "Portata " + fx\(q, 2\) + " m3/h sotto il minimo \(" + fx\(H.mn[ix], 1\) + "\)", RD, BG.R\); ko.push\("portata acqua sotto il minimo"\); }\nelse if \(q > H.mx[ix]\) { put\("portata_es", "Portata " + fx\(q, 2\) + " m3/h sopra il massimo \(" + fx\(H.mx[ix], 1\) + "\)", RD, BG.R\); ko.push\("portata acqua sopra il massimo"\); }\nelse put\("portata_es", "Portata nei limiti del catalogo", GR, BG.G\);\nvar pa = num\("press_acqua"\);\nif \(pa !== null && \(pa < 1 || pa > 2.5\)\) { col\("press_acqua", RD\); warn.push\("pressione acqua a freddo " + fx\(pa, 1\) + " bar"\); } else col\("press_acqua", BK\);\n// ---------- circuito frigorifero \(split\)\nif \(isSplit\) {\n  var vu = num\("vuoto_statico"\);\n  if \(vu === null\) { put\("vuoto_es", "Indicare il valore di vuoto", AM, BG.N\); miss.push\("valore di vuoto"\); }\n  else if \(vu <= 500\) put\("vuoto_es", "OK \(max 500 micron\)", GR, BG.G\);\n  else { put\("vuoto_es", "Oltre 500 micron: rifare il vuoto", RD, BG.R\); ko.push\("vuoto oltre 500 micron"\); }\n  var Lf = num\("lung_frigo"\), L0 = num\("lung_precar"\), gm = num\("gm_agg"\), w0 = num\("carica_w0"\), ag = num\("refr_aggiuntivo"\);\n  var rc = \(Lf !== null && L0 !== null && gm !== null\) ? Math.max\(0, Lf - L0\) * gm / 1000 : null;\n  put\("refr_calc", rc !== null ? fx\(rc, 2\) : ""\);\n  put\("refr_tot", w0 !== null ? fx\(w0 + \(ag !== null ? ag : \(rc || 0\)\), 2\) : ""\);\n  if \(Lf !== null && gas == "R32" && Lf < 3\) ko.push\("linea frigorifera R32 sotto 3 m"\);\n  if \(Lf !== null && gas == "R410A" && Lf < 5\) ko.push\("linea frigorifera R410A sotto 5 m"\);\n  var wmx = null, raffK = chk\("serv_raff"\) || chk\("serv_kit_raff"\);\n  if \(/^RAS-\(1\\.5|2|2\\.5|3\)WHVRP2E/.test\(mue\)\) wmx = 0.3; else if \(/^RAS-\(3\\.5|4|5|6\)WHV?RP2E/.test\(mue\)\) wmx = Lf !== null && Lf > 30 ? 1.8 : \(raffK ? 1.4 : 0.8\);\n  var fcm = F\("carica_max"\); if \(fcm\) { if \(wmx !== null\) { if \(fcm.value != fx\(wmx, 1\)\) fcm.value = fx\(wmx, 1\); sp\(fcm, "readonly", true\); sp\(fcm, "fillColor", ["RGB", 0.85, 0.95, 0.87]\); } else { sp\(fcm, "readonly", false\); sp\(fcm, "fillColor", ["RGB", 1, 0.97, 0.77]\); } }\n  var cmax = num\("carica_max"\), agv = ag !== null ? ag : rc;\n  put\("carica_max_tot", cmax !== null && w0 !== null ? fx\(w0 + cmax, 2\) : ""\);\n  if \(rc === null\) put\("refr_es", Lf === null ? "" : "Indicare lunghezza senza carica e g/m dall'etichetta", AM, BG.N\);\n  else if \(cmax !== null && agv !== null && agv > cmax + 0.005\) { put\("refr_es", "Oltre la carica massima aggiuntiva \(" + fx\(cmax, 1\) + " kg\)", RD, BG.R\); ko.push\("carica aggiuntiva oltre il massimo ammesso \(" + fx\(agv, 2\) + " > " + fx\(cmax, 1\) + " kg\)"\); }\n  else if \(ag === null\) { put\("refr_es", "Indicare la quantit\\u00E0 aggiunta \(calcolata " + fx\(rc, 2\) + " kg\)", AM, BG.A\); miss.push\("carica aggiuntiva"\); }\n  else if \(Math.abs\(ag - rc\) <= 0.1\) put\("refr_es", "OK: aggiunta coerente con il calcolo \(scarto " + fx\(ag - rc, 2\) + " kg\)", GR, BG.G\);\n  else { put\("refr_es", "Scarto " + fx\(ag - rc, 2\) + " kg rispetto al calcolo", AM, BG.A\); warn.push\("carica aggiunta diversa dal calcolo"\); }\n  if \(cmax === null && mue\) memo.push\("carica massima aggiuntiva da scrivere dal manuale U.E."\);\n} else { put\("vuoto_es", "", BK, BG.N\); put\("refr_calc", ""\); put\("refr_tot", ""\); put\("refr_es", "", BK, BG.N\); put\("carica_max_tot", ""\); }\n// ---------- R290\nvar rt = g\("r290_tipo"\), Z = D.ZONA[rt];\nif \(isR290\) {\n  var txt = "", bad = [], mz = 0;\n  for \(var i = 0; i < D.ZL.length; i++\) {\n    var l = D.ZL[i], need = Z ? Z[l] : null, v = num\("r290_" + l\);\n    put\("r290_" + l + "_min", need ? "min " + need : \(Z ? "n.r." : ""\), need ? BK : ["RGB", 0.5, 0.5, 0.5]\);\n    if \(need\) {\n      txt += \(txt ? "  " : ""\) + l + " >= " + need;\n      if \(v === null\) { mz++; col\("r290_" + l, BK\); }\n      else if \(v < need\) { bad.push\(l + " " + v + " < " + need\); col\("r290_" + l, RD\); }\n      else col\("r290_" + l, GR\);\n    } else col\("r290_" + l, BK\);\n  }\n  put\("r290_min", Z ? txt + " mm" : "Scegliere la posizione dell'unit\\u00E0"\);\n  if \(!Z\) { put\("r290_es", "Indicare la posizione dell'unit\\u00E0 esterna", AM, BG.N\); miss.push\("posizione unit\\u00E0 R290"\); }\n  else if \(bad.length\) { put\("r290_es", "NON CONFORME: " + bad.join\(", "\) + " mm", RD, BG.R\); ko.push\("zona di protezione R290 \(" + bad.join\(", "\) + "\)"\); }\n  else if \(mz\) { put\("r290_es", "Misurare tutte le distanze richieste \(" + mz + " mancanti\)", AM, BG.A\); miss.push\("distanze R290"\); }\n  else put\("r290_es", "Distanze conformi", GR, BG.G\);\n  if \(g\("r290_confine"\) == "SI"\) ko.push\("zona R290 su propriet\\u00E0 confinanti / aree pubbliche"\);\n} else { put\("r290_min", ""\); put\("r290_es", "", BK, BG.N\); for \(var i = 0; i < D.ZL.length; i++\) put\("r290_" + D.ZL[i] + "_min", ""\); }\n// ---------- tensioni e assorbimento\nvar YL = ["RGB", 1, 0.97, 0.77], GY = ["RGB", 0.82, 0.83, 0.85];\nfunction en\(n, on\){ var f = F\(n\); if \(!f\) return; if \(f.readonly != !on\) sp\(f, "readonly", !on\); sp\(f, "fillColor", on ? YL : GY\); }\nvar ta = g\("tipo_alim"\), mono = ta == "Monofase", tri = ta == "Trifase", vn = mono ? 230 : tri ? 400 : null;\nput\("tens_nom", vn ? String\(vn\) : ""\);\nen\("tens_ln_vuoto", !tri\); en\("tens_ln", !tri\);\nvar TF = ["tens_l1n", "tens_l2n", "tens_l3n", "tens_l12", "tens_l23", "tens_l31", "corr_l2", "corr_l3"];\nfor \(var i = 0; i < TF.length; i++\) en\(TF[i], !mono\);\nfunction arr\(L\){ var o = []; for \(var i = 0; i < L.length; i++\) { var x = num\(L[i]\); if \(x !== null\) o.push\(x\); } return o; }\nfunction avg\(a\){ var t = 0; for \(var i = 0; i < a.length; i++\) t += a[i]; return a.length ? t / a.length : null; }\nfunction sq\(a\){ var m = avg\(a\), d = 0; for \(var i = 0; i < a.length; i++\) d = Math.max\(d, Math.abs\(a[i] - m\)\); return d / m * 100; }\nvar nt = num\("tens_nt"\), Vp = [], Vc = [], Ia = [], vref = null;\nif \(vn\) {\n  var out = [], msg = "", sqv = null;\n  if \(mono\) { Vp = arr\(["tens_ln"]\); if \(!Vp.length\) Vp = arr\(["tens_ln_vuoto"]\); for \(var i = 0; i < Vp.length; i++\) if \(Vp[i] < 207 || Vp[i] > 253\) out.push\(Vp[i]\); Ia = arr\(["corr_l1"]\); }\n  else {\n    Vp = arr\(["tens_l1n", "tens_l2n", "tens_l3n"]\); Vc = arr\(["tens_l12", "tens_l23", "tens_l31"]\); Ia = arr\(["corr_l1", "corr_l2", "corr_l3"]\);\n    for \(var i = 0; i < Vp.length; i++\) if \(Vp[i] < 207 || Vp[i] > 253\) out.push\(Vp[i]\);\n    for \(var i = 0; i < Vc.length; i++\) if \(Vc[i] < 360 || Vc[i] > 440\) out.push\(Vc[i]\);\n    if \(Vc.length == 3\) sqv = sq\(Vc\); else if \(Vp.length == 3\) sqv = sq\(Vp\);\n  }\n  put\("tens_sq", sqv !== null ? fx\(sqv, 1\) : "", sqv !== null && sqv > 2 ? RD : BK\);\n  if \(!Vp.length && !Vc.length\) { put\("tens_es", "Indicare le tensioni", AM, BG.N\); miss.push\("tensioni"\); }\n  else {\n    if \(out.length\) { msg = "Fuori +/-10%: " + out.join\(", "\) + " V"; ko.push\("tensione fuori tolleranza"\); }\n    if \(sqv !== null && sqv > 2\) { msg += \(msg ? " - " : ""\) + "squilibrio " + fx\(sqv, 1\) + "% oltre 2%"; warn.push\("squilibrio tensioni oltre 2%"\); }\n    if \(tri && Ia.length == 3 && sq\(Ia\) > 10\) { msg += \(msg ? " - " : ""\) + "correnti squilibrate " + fx\(sq\(Ia\), 0\) + "%"; warn.push\("assorbimenti squilibrati tra le fasi"\); }\n    if \(nt !== null && nt >= 5\) { msg += \(msg ? " - " : ""\) + "N/T " + nt + " V"; warn.push\("tensione neutro/terra " + nt + " V"\); }\n    put\("tens_es", out.length ? msg : \(msg ? msg : "OK"\), out.length ? RD : \(msg ? AM : GR\), out.length ? BG.R : \(msg ? BG.A : BG.G\)\);\n  }\n} else { put\("tens_es", "", BK, BG.N\); put\("tens_sq", ""\); }\nvar cosf = num\("cosfi"\); if \(cosf === null || cosf <= 0 || cosf > 1\) cosf = 0.95;\nvar pmis = num\("pot_el_mis"\), Pel = null, Iav = avg\(Ia\);\nif \(pmis !== null\) Pel = pmis;\nelse if \(mono && Vp.length && Iav !== null\) Pel = avg\(Vp\) * Iav * cosf / 1000;\nelse if \(tri && Iav !== null && Vc.length\) Pel = 1.732 * avg\(Vc\) * Iav * cosf / 1000;\nelse if \(tri && Iav !== null && Vp.length\) Pel = 3 * avg\(Vp\) * Iav * cosf / 1000;\nput\("pot_el", Pel !== null ? fx\(Pel, 2\) : ""\); put\("pot_el_show", Pel !== null ? fx\(Pel, 2\) : ""\);\n// ---------- prestazioni: delta T, potenza resa, COP / EER\nvar mp = g\("mod_prova"\), tm = num\("t_mand"\), tr = num\("t_rit"\), cool = mp == "Raffreddamento";\nif \(tm !== null && tr !== null\) {\n  var dt = cool ? tr - tm : tm - tr; put\("dt_acqua", fx\(dt, 1\)\);\n  var dmax = mp == "ACS" ? 10 : 8;\n  if \(dt <= 0\) { put\("dt_es", "Mandata/ritorno invertiti?", RD, BG.R\); warn.push\("delta T acqua negativo: verificare sonde o modalit\\u00E0 di prova"\); }\n  else if \(dt >= 3 && dt <= dmax\) put\("dt_es", "OK \(3 - " + dmax + " \\u00B0C\)", GR, BG.G\);\n  else if \(dt > dmax\) { put\("dt_es", "Alto: portata bassa?", AM, BG.A\); warn.push\("delta T acqua " + fx\(dt, 1\) + " \\u00B0C \(portata bassa?\)"\); }\n  else { put\("dt_es", "Basso: portata alta?", AM, BG.A\); warn.push\("delta T acqua " + fx\(dt, 1\) + " \\u00B0C"\); }\n  if \(q !== null && dt > 0\) {\n    var Pr = q * 1.163 * dt;\n    put\("pot_resa", \(cool ? "Frigorifera " : "Termica "\) + fx\(Pr, 2\) + " kW"\);\n    if \(Pel !== null && Pel > 0\) put\("cop", \(cool ? "EER " : "COP "\) + fx\(Pr / Pel, 2\) + "  \(" + fx\(Pr, 2\) + " kW resi / " + fx\