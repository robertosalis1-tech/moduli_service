<< /JS (var d = this;\nfunction g\(n\){ var f = d.getField\(n\); if \(!f || f.value === null || f.value === undefined\) return ""; return String\(f.value\); }\nfunction num\(n\){ var s = g\(n\).replace\(",", "."\).replace\(/\\s/g, ""\); if \(s === ""\) return null; var x = Number\(s\); return isNaN\(x\) ? null : x; }\nfunction put\(n, v\){ var f = d.getField\(n\); if \(f && f.value != v\) f.value = v; }\nvar ns = 0, td = 0, nd = 0;\nfor \(var i = 1; i <= 10; i++\) {\n  var pre = "pu_ue" + i + "_";\n  if \(g\(pre + "mod"\) !== "" || g\(pre + "sn"\) !== "" || g\(pre + "ui"\) !== ""\) ns++;\n  var x = num\(pre + "ui"\); if \(x !== null\) { td += x; nd++; }\n}\nput\("pu_ue_nsis", ns ? String\(ns\) : ""\);\nput\("pu_ue_totd", nd ? String\(td\) : ""\);\nevent.value = "";) /S /JavaScript >>
endobj
