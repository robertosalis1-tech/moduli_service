(!isNaN\(ph\) && \(ph < 7.5 || ph > 8.0\)\) e.push\('pH fuori 7,5-8,0'\);\nif \(!isNaN\(dh\) && \(dh < 4.8 || dh > 8.5\)\) e.push\('durezza fuori 4,8-8,5 \\u00B0dH'\);\nif \(!isNaN\(cl\) && cl >= 50\) e.push\('cloruri >= 50 ppm'\);\nif \(isNaN\(ph\) && isNaN\(dh\) && isNaN\(cl\)\) EV.value = '';\nelse if \(e.length\) { smOk\(false\); EV.value = 'NON CONFORME: ' + e.join\(', '\) + ' \(trattare secondo UNI 8065\)'; }\nelse { smOk\(true\); EV.value = 'Valori nei limiti del manuale'; } }\)\(\); var o = d.getField\("w_esito"\); if \(o\) { if \(o.value != EV.value\) o.value = EV.value; o.textColor = EV.target.textColor; } } catch \(e\) { }\ntry { EV = {value: "", target: {textColor: ["RGB",0,0,0]}}; \(function\(\){ EV.target.textColor = ['RGB',0,0,0];\nif \(!smAnyMod\(d\)\) EV.value = '';\nelse if \(smAnyX\(d\)\) { smOk\(false\); EV.value = 'SI - compilare tutta la sezione 4'; }\nelse { smOk\(true\); EV.value = 'NO - rispondere N.A. alle voci della sezione 4'; } }\)\(\); var o = d.getField\("r454_flag"\); if \(o\) { if \(o.value != EV.value\) o.value = EV.value; o.textColor = EV.target.textColor; } } catch \(e\) { }\nevent.value = "";) /S /JavaScript >>
