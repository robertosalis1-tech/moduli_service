<</JS(var d = this; var EV = {value: "", target: {textColor: ["RGB",0,0,0]}};\n\nvar SM = {\n  hp:   [18, 24, 30, 40, 50, 60, 75, 90, 100],\n  circ: [1, 1, 2, 2, 2, 3, 3, 4, 4],\n  chN:  [9.5, 12.3, 17.6, 20.5, 22.8, 29.5, 32.0, 43.3, 45.6],\n  chX:  [8.0, 10.8, 16.0, 18.0, 20.0, 26.3, 28.7, 38.0, 40.0],\n  kwN:  [44.6, 60.2, 78.2, 99.1, 122.8, 159.6, 188.2, 222.2, 255.1],\n  kwX:  [43.0, 58.0, 76.0, 96.0, 119.0, 155.0, 184.0, 216.0, 248.0],\n  qc:   [2.1, 2.9, 3.7, 4.7, 5.8, 7.6, 9.0, 10.6, 12.1],\n  qh:   [2.4, 2.9, 4.2, 4.8, 6.3, 7.8, 9.2, 11.1, 12.3],\n  qmin: [1.1, 1.4, 1.9, 2.4, 3.0, 3.7, 4.5, 5.3, 6.0],\n  qmax: [2.8, 3.7, 5.0, 6.2, 7.8, 11.1, 13.6, 15.8, 17.9],\n  vc:   [148, 199, 259, 327, 406, 527, 622, 734, 842],\n  vp:   [291, 392, 509, 644, 799, 1038, 1224, 1445, 1658],\n  att:  ['2"', '2"', '2 1/2"', '2 1/2"', '2 1/2"', '4"', '4"', '4"', '4"'],\n  imN:  [35.1, 38.3, 60.9, 71.7, 85.2, 119.5, 133.1, 166.4, 179.9],\n  imNk: [38.7, 41.9, 65.6, 76.4, 89.9, 126.9, 140.5, 173.8, 187.3],\n  imX:  [32.0, 35.1, 56.3, 66.6, 79.3, 110.8, 123.5, 155.0, 167.7],\n  imXk: [35.6, 38.7, 61.0, 71.3, 84.0, 118.2, 130.9, 162.4, 175.1],\n  dpN:  [32, 25, 27, 30, 36, 25, 32, 41, 38],\n  dpX:  [30, 30, 28, 32, 36, 23, 29, 41, 38],\n  cf: [[1.4169, -2.7902, 18.488, -9.0295], [0.1071, 1.3526, 4.525, -3.4853], [-0.1316, 3.4848, -6.0541, 7.4083],\n       [-0.1233, 2.6949, -4.8171, 5.4692], [-0.0589, 1.8285, -3.8203, 6.6512], [0.0117, 0.0583, 2.7108, -5.8985],\n       [-0.0041, 0.4305, -0.4644, 2.9758], [0.0065, 0.0985, 2.5877, -7.5858], [0.0004, 0.2096, 0.5379, -1.1606]],\n  sHp: [4, 5, 6, 7], sKw: [11.2, 14.3, 16.0, 17.8], sQ: [1.9, 2.4, 2.7, 3.1], sV: [45, 55, 55, 55], sI: [24, 33, 33, 36],\n  sCh: [2.8, 3.3, 3.9, 4.0], sQmin: [1.2, 1.2, 1.6, 1.8], sQmax: [2.7, 3.4, 3.8, 4.3],\n  sCf: [[-9.7532, 46.869, -115.22, 261.76], [0.2641, -10.953, -3.6167, 203.71], [2.0658, -25.08, 32.499, 179.42], [2.0658, -25.08, 32.499, 179.42]],\n  lCh134: [19, 20, 24, 29], lQmin: [15.1, 19.4, 23.7, 26.9], lQmax: [52.3, 67.3, 82.3, 83.8], lQcMax: [62.8, 80.9, 83.8, 83.8],\n  lEa: [0.0580, 0.0390, 0.0233, 0.0233], lEb: [1.8359, 1.8390, 1.8552, 1.8552], lCa: [0.0380, 0.0265, 0.0197, 0.0158], lCb: [1.8810, 1.8800, 1.8847, 1.8926],\n  lHp: [40, 50, 60, 70], lKw: [140, 180, 220, 250], lVc: [510, 650, 800, 900], lQe: [24.1, 31.0, 37.8, 43.0],\n  lQc513: [29.1, 37.5, 46.0, 52.3], lQc134: [28.9, 37.2, 45.6, 51.8],\n  eg: [[0, 0], [10, -3.4], [20, -7.9], [30, -14.1], [40, -22.3], [50, -33.8]],\n  pg: [[0, 0], [10, -3.3], [20, -7.1], [30, -12.7], [40, -21.1], [50, -33.5]]\n};\nfunction smV\(d, n\) { var f = d.getField\(n\); return f ? String\(f.value\) : ''; }\nfunction smN\(d, n\) { var s = smV\(d, n\).replace\(',', '.'\).replace\(/\\s/g, ''\); if \(s === ''\) return NaN; var v = parseFloat\(s\); return isNaN\(v\) ? NaN : v; }\nfunction smF\(v, n\) { if \(v === null || isNaN\(v\)\) return ''; return v.toFixed\(n\).replace\('.', ','\); }\nfunction smOk\(ok\) { EV.target.textColor = ok ? ['RGB', 0, 0.45, 0.15] : ['RGB', 0.8, 0, 0.1]; }\nfunction smIdx\(a, v\) { for \(var i = 0; i < a.length; i++\) if \(a[i] == v\) return i; return -1; }\nfunction smK\(d, r\) { var k = smV\(d, 'm' + r + '_kit'\); return k.indexOf\('FS'\) == 0 || k.indexOf\('VSD'\) == 0; }\n// scheda dati del modulo r \(null se non scelto\)\nfunction smInfo\(d, r\) {\n  var v = smV\(d, 'm' + r + '_mod'\), m, i, o;\n  if \(\(m = /RHMA \(\\d+\)AVN/.exec\(v\)\)\) {\n    i = smIdx\(SM.sHp, parseInt\(m[1], 10\)\); if \(i < 0\) return null;\n    o = { fam: 'S', ref: 'R410A', gwp: 2088, circ: 1, ch: SM.sCh[i], kw: SM.sKw[i], i: i, mono: true };\n    o.qn = SM.sQ[i]; o.qmin = SM.sQmin[i]; o.qmax = SM.sQmax[i]; o.vc = SM.sV[i]; o.vp = Math.max\(SM.sV[i], Math.round\(o.kw * 6.5\)\); o.imax = SM.sI[i]; o.mod = 'RHMA ' + m[1] + 'AVN';\n    return o;\n  }\n  if \(\(m = /RHMA \(\\d+\)A\([NX]\)/.exec\(v\)\)\) {\n    i = smIdx\(SM.hp, parseInt\(m[1], 10\)\); if \(i < 0\) return null;\n    var x = m[2] == 'X', k = smK\(d, r\);\n    o = { fam: 'M', ref: x ? 'R454B' : 'R410A', gwp: x ? 466 : 2088, circ: SM.circ[i], ch: x ? SM.chX[i] : SM.chN[i], kw: x ? SM.kwX[i] : SM.kwN[i], i: i };\n    o.qn = SM.qc[i] * 3.6; o.qh = SM.qh[i] * 3.6; o.qmin = SM.qmin[i] * 3.6; o.qmax = SM.qmax[i] * 3.6; o.vc = SM.vc[i]; o.vp = SM.vp[i];\n    o.imax = \(x ? \(k ? SM.imXk : SM.imX\) : \(k ? SM.imNk : SM.imN\)\)[i]; o.dpn = \(x ? SM.dpX : SM.dpN\)[i]; o.att = SM.att[i];\n    o.mod = 'RHMA ' + m[1] + 'A' + m[2];\n    return o;\n  }\n  if \(\(m = /RCME \(\\d+\)WH1 \\\(\(R\\d+A\)\\\)/.exec\(v\)\)\) {\n    i = smIdx\(SM.lHp, parseInt\(m[1], 10\)\); if \(i < 0\) return null;\n    o = { fam: 'L', ref: m[2], gwp: m[2] == 'R513A' ? 631 : 1430, circ: 1, ch: m[2] == 'R134A' ? SM.lCh134[i] : NaN, kw: SM.lKw[i], i: i };\n    o.qn = SM.lQe[i]; o.qmin = SM.lQmin[i]; o.qmax = SM.lQmax[i]; o.qcmax = SM.lQcMax[i]; o.vc = SM.lVc[i]; o.vp = Math.max\(SM.lVc[i], Math.round\(SM.lKw[i] * 6.5\)\);\n    o.qcond = \(m[2] == 'R513A' ? SM.lQc513 : SM.lQc134\)[i]; o.mod = 'RCME ' + m[1] + 'WH1';\n    return o;\n  }\n  return null;\n}\nfunction smCO2\(o\) { return \(o && !isNaN\(o.ch\)\) ? o.ch * o.gwp / 1000 : NaN; }\nfunction smMod\(d, r, what\) {\n  var o = smInfo\(d, r\); EV.target.textColor = ['RGB', 0, 0, 0];\n  if \(!o\) return '';\n  if \(what == 'ref'\) return o.ref + \(o.fam == 'M' && o.ref == 'R454B' ? ' \(A2L\)' : ''\);\n  if \(what == 'circ'\) return String\(o.circ\);\n  if \(what == 'carica'\) return isNaN\(o.ch\) ? 'targhetta' : smF\(o.ch, 1\);\n  if \(what == 'co2'\) return isNaN\(o.ch\) ? 'targhetta' : smF\(smCO2\(o\), 2\);\n  if \(what == 'q'\) return o.fam == 'M' ? smF\(o.qn, 1\) + ' / ' + smF\(o.qh, 1\) : smF\(o.qn, 1\);\n  if \(what == 'range'\) return smF\(o.qmin, 1\) + ' - ' + smF\(o.qmax, 1\);\n  if \(what == 'imax'\) return o.imax ? smF\(o.imax, 1\) : 'targhetta';\n  if \(what == 'att'\) return o.att ? o.att + ' Vic.' : '-';\n  if \(what == 'dpn'\) return o.dpn ? String\(o.dpn\) : '-';\n  if \(what == 'qcond'\) return o.qcond ? smF\(o.qcond, 1\) + ' \(max ' + smF\(o.qcmax, 1\) + '\)' : '';\n  if \(what == 'fgas'\) { var t = smCO2\(o\); if \(isNaN\(t\)\) return 'da targhetta'; if \(t < 5\) return 'Nessun obbligo'; if \(t < 50\) return 'Ogni 12 mesi'; if \(t < 500\) return 'Ogni 6 mesi'; return 'Ogni 3 mesi'; }\n  if \(what == 'modello'\) return o.mod;\n  return '';\n}\nfunction smProc\(d\) { return smV\(d, 'appl'\).indexOf\('Processo'\) == 0; }\nfunction smVolMin\(d\) { var s = 0, n = 0; for \(var r = 1; r <= 4; r++\) { var o = smInfo\(d, r\); if \(o\) { s += smProc\(d\) ? o.vp : o.vc; n++; } } return n ? s : NaN; }\nfunction smAnyX\(d\) { for \(var r = 1; r <= 4; r++\) { var o = smInfo\(d, r\); if \(o && o.ref == 'R454B'\) return true; } return false; }\nfunction smAnyMod\(d\) { for \(var r = 1; r <= 4; r++\) if \(smInfo\(d, r\)\) return true; return false; }\nfunction smFreeze\(tipo, pct\) { var t = tipo.indexOf\('ropil'\) >= 0 ? SM.pg : SM.eg; if \(pct <= 0\) return 0; for \(var k = 1; k < t.length; k++\) if \(pct <= t[k][0]\) { var a = t[k - 1], b = t[k]; return a[1] + \(b[1] - a[1]\) * \(pct - a[0]\) / \(b[0] - a[0]\); } return t[t.length - 1][1]; }\nfunction smGlic\(d, tipoN, pctN\) {\n  var p = smN\(d, pctN\); EV.target.textColor = ['RGB', 0, 0, 0];\n  if \(isNaN\(p\)\) return '';\n  if \(p > 45\) { smOk\(false\); return 'OLTRE IL MASSIMO AMMESSO \(45%\)'; }\n  if \(p == 0\) { if \(smProc\(d\)\) { smOk\(false\); return 'Con acqua sotto +5 \\u00B0C il glicole \\u00E8 obbligatorio'; } return 'Solo acqua'; }\n  smOk\(true\); return 'Protezione antigelo fino a circa ' + smF\(smFreeze\(smV\(d, tipoN\), p\), 0\) + ' \\u00B0C';\n}\n// curve portata \(m3/h\) <-> perdita di carico \(kPa\)\n// M: perdita di carico scambiatore \(manuale TCIT0145 par. 8.13, x in l/s\); S: prevalenza utile pompa di serie \(SMGB0132\);\n// L: CPD = a * Q^b \(catalogo TCIT0120 par. 4.2.3\); cond = true per il condensatore Samurai L\nfunction smDP\(o, q, cond\) {\n  if \(!o || isNaN\(q\) || q <= 0\) return NaN; var c, x;\n  if \(o.fam == 'M'\) { c = SM.cf[o.i]; x = q / 3.6; return \(\(c[0] * x + c[1]\) * x + c[2]\) * x + c[3]; }\n  if \(o.fam == 'S'\) { c = SM.sCf[o.i]; x = q; return \(\(c[0] * x + c[1]\) * x + c[2]\) * x + c[3]; }\n  if \(o.fam == 'L'\) return cond ? SM.lCa[o.i] * Math.pow\(q, SM.lCb[o.i]\) : SM.lEa[o.i] * Math.pow\(q, SM.lEb[o.i]\);\n  return NaN;\n}\nfunction smQdp\(o, dp, cond\) {\n  if \(!o || isNaN\(dp\) || dp <= 0\) return NaN;\n  if \(o.fam == 'L'\) return cond ? Math.pow\(dp / SM.lCa[o.i], 1 / SM.lCb[o.i]\) : Math.pow\(dp / SM.lEa[o.i], 1 / SM.lEb[o.i]\);\n  var lo = o.fam == 'M' ? o.qmin * 0.6 : 0.8, hi = o.fam == 'M' ? o.qmax * 1.5 : 5.0, dec = o.fam == 'S';\n  var f = function \(q\) { var v = smDP\(o, q, cond\) - dp; return dec ? -v : v; };\n  if \(f\(lo\) > 0 || f\(hi\) < 0\) return -1;\n  for \(var k = 0; k < 60; k++\) { var mm = \(lo + hi\) / 2; if \(f\(mm\) > 0\) hi = mm; else lo = mm; } return \(lo + hi\) / 2;\n}\n// portata usata per esito e potenza: da perdita di carico se inserita, altrimenti portata letta \(m3/h\)\nfunction smQuse\(d, r, pre, cond\) {\n  var o = smInfo\(d, r\); if \(!o\) return NaN;\n  var dp = smN\(d, pre + r + '_dp'\), ql = smN\(d, pre + r + '_ql'\);\n  if \(!isNaN\(dp\) && dp > 0\) return smQdp\(o, dp, cond\);\n  return ql;\n}\nfunction smUnb\(a\) { var v = [], s = 0; for \(var k = 0; k < a.length; k++\) if \(!isNaN\(a[k]\)\) { v.push\(a[k]\); s += a[k]; } if \(v.length < 2\) return NaN; var m = s / v.length, x = 0; for \(k = 0; k < v.length; k++\) x = Math.max\(x, Math.abs\(v[k] - m\)\); return x / m * 100; }\n\ntry { EV = {value: "", target: {textColor: ["RGB",0,0,0]}}; \(function\(\){ EV.value = smMod\(d, 1, 'ref'\); }\)\(\); var o = d.getField\("m1_ref"\); if \(o\) { if \(o.value != EV.value\) o.value = EV.value; o.textColor = EV.target.textColor; } } catch \(e\) { }\ntry { EV = {value: "", target: {textColor: ["RGB",0,0,0]}}; \(function\(\){ EV.value = smMod\(d, 1, 'circ'\); }\)\(\); var o = d.g